# Copy to src/core/config/secrets/.env (or .env at the repo root) and fill in values.
# Never commit real secrets. Real environment variables override these files.

# --- App ---
APP_NAME=Web API
APP_VERSION=0.1.0
APP_ENV=development              # development | staging | production
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=5000
RELOAD=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=app/logs                 # relative to the repo root
LOG_TO_FILE=true

# --- PostgreSQL ---
DB_ENABLED=true
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_SCHEMA=public
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# --- JWT (only when the project adds auth; min 32 chars in production) ---
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- HTTP / security ---
# CORS_ORIGINS=https://app.example.com,https://admin.example.com   # empty = localhost:3000/5173 in dev, none in production
# CORS_ALLOW_CREDENTIALS=true
# API_DOCS_ENABLED=              # unset = on, except in production
# SECURITY_HEADERS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=31536000
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=300      # per client IP, all routes
# EXPOSE_READINESS_ERRORS=false
# HTTP_CLIENT_TIMEOUT=30

# --- Admin API (/config, /permissions, menu writes) ---
# Sent as header X-API-Key. Unset = open in development, refused in production (min 32 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=
# CONFIG_CACHE_TTL_SECONDS=60
