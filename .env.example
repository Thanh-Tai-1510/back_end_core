# PostgreSQL (bắt buộc)
PG_USER=postgres
PG_PASSWORD=your_password
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=financial_statement
PG_SCHEMA=web_app

# Admin mặc định khi chạy init_db.py (tùy chọn)
ADMIN_EMAIL=admin@local.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# System account khi chạy init_db.py (tùy chọn)
SYSTEM_EMAIL=system@local.dev
SYSTEM_USERNAME=system
SYSTEM_PASSWORD=System@123
